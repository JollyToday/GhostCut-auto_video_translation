{
  "manifest_version":"0.3","name":"weydub-media","display_name":"Weydub Media Localization","version":"1.0.1",
  "description":"Remove video captions, extract full-frame OCR subtitles, dub speech and translate product images with Weydub.",
  "author":{"name":"Weydub","url":"https://weydub.com/"},"homepage":"https://weydub.com/docs/api/",
  "server":{"type":"node","entry_point":"mcp/server.mjs","mcp_config":{"command":"node","args":["${__dirname}/mcp/server.mjs"],
    "env":{"WEYDUB_APP_KEY":"${user_config.app_key}","WEYDUB_APP_SECRET":"${user_config.app_secret}"}}},
  "user_config":{
    "app_key":{"type":"string","title":"Weydub AppKey","description":"Your own Weydub API AppKey.","sensitive":true,"required":true},
    "app_secret":{"type":"string","title":"Weydub AppSecret","description":"Your own Weydub API signing secret.","sensitive":true,"required":true}
  }
}
