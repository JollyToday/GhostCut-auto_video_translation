      "position": [
        960,
        -180
      ],
      "parameters": {
        "operation": "completion",
        "respondWith": "text",
        "completionTitle": "Save your private receipt",
        "completionMessage": "={{ \"Copy this receipt before uploading: \" + $json.receipt + \". Open the form again and choose Upload my authorized MP4. Anyone with the receipt can retrieve the result.\" }}"
      }
    },
    {
      "id": "982d91c1-d24e-41aa-afb5-000000000006",
      "name": "Upload authorized clip",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        710,
        40
      ],
      "parameters": {
        "url": "https://api.weydub.com/agent-trial/v1/removal",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Trial-Receipt",
              "value": "={{ $json.receipt }}"
            },
            {
              "name": "Content-Type",
              "value": "video/mp4"
            }
          ]
        },
        "sendBody": true,
        "contentType": "binaryData",
        "inputDataFieldName": "clip",
        "options": {
          "timeout": 90000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "982d91c1-d24e-41aa-afb5-000000000007",
      "name": "Check saved receipt",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        710,
        230
      ],
      "parameters": {
        "url": "https://api.weydub.com/agent-trial/v1/removal",
        "method": "GET",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Trial-Receipt",
              "value": "={{ $json.receipt }}"
            }
          ]
        },
        "options": {
          "timeout": 90000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
