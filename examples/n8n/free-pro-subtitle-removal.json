        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "982d91c1-d24e-41aa-afb5-000000000008",
      "name": "Read processing status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        120
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\n  const code=$json.statusCode, data=$json.body??{};\n  const show=(title,message)=>({json:{title,message,ready:false}});\n  if(code===429)return show('Trial capacity unavailable','No paid job was started. Keep your receipt and try again later.');\n  if(code===404)return show('No clip on this receipt','Check the receipt you pasted. If you have not submitted the clip, use Upload my authorized MP4.');\n  if(code===409)return show('This receipt belongs to another clip','Check the original receipt. Use a new one only for a different video.');\n  if([413,415,422].includes(code))return show('Check your video','Use an H.264 MP4 of up to 60 seconds and 16 MiB, with AAC audio or no audio.');\n  if(![200,202].includes(code))return show('Request not confirmed','Keep the same receipt and check your result before retrying.');\n  if(data.state==='ready' && data.videoUrl) {\n    if(/^https:\\/\\/[a-z0-9.-]+\\/[^\\s\\\\<>\"]+$/i.test(data.videoUrl))return {json:{ready:true,url:data.videoUrl}};\n    return show('Download unavailable','Keep your receipt and check again later.');\n  }\n  if(['queued','submitting','processing','ready'].includes(data.state))return show(\n    data.replayed?'This clip was already submitted':(data.state==='ready'?'Your clip is ready':'Your clip is being processed'),\n    'Open the form again, select Check my result and use the same receipt. Leave the file field empty.');\n  return show('This result is unavailable','Keep your receipt. Processing may have failed or the download may have expired.');\n"
      }
    },
    {
      "id": "982d91c1-d24e-41aa-afb5-000000000009",
