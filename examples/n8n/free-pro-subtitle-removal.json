{
  "name": "Weydub: try full-frame Pro subtitle removal",
  "id": "WeydubSponsoredPro",
  "active": false,
  "nodes": [
    {
      "id": "982d91c1-d24e-41aa-afb5-000000000001",
      "name": "Try subtitle removal",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.4,
      "position": [
        0,
        180
      ],
      "parameters": {
        "authentication": "basicAuth",
        "formTitle": "Remove burned-in subtitles",
        "formDescription": "Use an H.264 MP4 you may share, up to 60 seconds and 16 MiB. Pro scans the whole picture, including signs and prices. First create and save a private receipt. Only the upload action sends your clip to Weydub.",
        "formFields": {
          "values": [
            {
              "fieldName": "action",
              "fieldLabel": "Action",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Create a private receipt"
                  },
                  {
                    "option": "Upload my authorized MP4"
                  },
                  {
                    "option": "Check my result"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldName": "receipt",
              "fieldLabel": "Private receipt",
              "fieldType": "password"
            },
            {
              "fieldName": "clip",
              "fieldLabel": "Your MP4 (upload only)",
              "fieldType": "file",
              "multipleFiles": false,
              "acceptFileTypes": ".mp4"
            }
          ]
        },
        "responseMode": "lastNode",
        "options": {
          "buttonLabel": "Continue",
          "appendAttribution": false
        }
      },
      "webhookId": "15475c47-42a0-48d7-a931-f43f35f48900"
    },
    {
      "id": "982d91c1-d24e-41aa-afb5-000000000002",
      "name": "Check the form",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        230,
        180
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\n  const {action,receipt=''}=$json;\n  const key=String(receipt??'').trim();\n  const file=$binary?.clip;\n  const stop=message=>({json:{route:3,title:'Check your form',message}});\n  if(action==='Create a private receipt' && !file && !key)return {json:{route:0}};\n  if(action==='Create a private receipt')return stop('Leave the receipt and file empty to create a receipt. To resume, choose Check my result.');\n  if(!/^[a-f0-9]{64}$/.test(key))return stop('Paste the complete 64-character receipt. Create one first if you are starting a new clip.');\n  if(action==='Check my result' && !file)return {json:{route:2,receipt:key}};\n  if(action==='Check my result')return stop('Remove the selected file to check your result. Nothing was sent to Weydub.');\n  if(action!=='Upload my authorized MP4' || !file)return stop('Select the upload action and choose one H.264 MP4 that you may send to Weydub.');\n  if(!/\\.mp4$/i.test(file.fileName??''))return stop('Choose an MP4 file. Nothing was sent to Weydub.');\n  return {json:{route:1,receipt:key},binary:{clip:file}};\n"
      }
    },
    {
      "id": "982d91c1-d24e-41aa-afb5-000000000003",
      "name": "Choose action",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        460,
        180
      ],
      "parameters": {
        "mode": "expression",
        "numberOutputs": 4,
        "output": "={{ $json.route }}"
      }
    },
    {
